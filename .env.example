PEXELS_API_KEY= # crucial for the project to work
LOG_LEVEL=trace # trace, debug, info, warn, error, fatal, silent
WHISPER_VERBOSE=true
PORT=3123
DEV=true # local development mode
DATA_DIR_PATH= # only for docker, otherwise leave empty

# --- Lead finder (cold player search in YouTube/TikTok comments) ---
LEAD_FINDER_ENABLED=true # mount /api/leads in the main server
YOUTUBE_API_KEY= # YouTube Data API v3 key (Google Cloud console), read-only
DISCORD_BOT_TOKEN= # Discord bot token (Developer Portal -> Bot), enable Message Content Intent; reads only servers the bot was invited to
ANTHROPIC_API_KEY= # optional: enables Claude classification of comments (otherwise keyword rules only)
LEAD_FINDER_LLM_MODEL=claude-opus-5-5 # e.g. claude-haiku-5-5 for a cheaper classifier
LEAD_FINDER_LLM_PREFILTER=signals # signals = only comments with server-related words go to the LLM; all = every comment
LEAD_FINDER_SCAN_INTERVAL_MINUTES=0 # 0 = scan only on API call; e.g. 360 = every 6 hours
LEAD_FINDER_DAILY_QUOTA=9000 # soft cap on YouTube API units per day (Google default is 10000)
LEAD_FINDER_MIN_RESCAN_MINUTES=60 # don't re-read the same video more often
LEAD_FINDER_DB_PATH= # default: <DATA_DIR_PATH>/leads.db
LEAD_FINDER_API_TOKEN= # optional: require "Authorization: Bearer <token>" on /api/leads
LEAD_FINDER_PORT=3124 # standalone mode only (npm run leads)
